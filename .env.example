# Copy to .env and fill in keys for the providers you use.
#   cp .env.example .env
#
# liteness loads this automatically on startup (from the current working
# directory, or LITENESS_ENV_FILE). Values already set in the shell are not
# overwritten.

# OpenAI (--provider openai)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (--provider google)
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alternate name, also accepted

# Command Code Provider API (--provider commandcode)
COMMANDCODE_API_KEY=

# ClickHouse export (--clickhouse, optional)
# LITENESS_CLICKHOUSE_URL=http://localhost:8123
